---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import path from "node:path";
import organization from "../data/organization.json";
import announcement from "../data/announcement.json";
import { withBase } from "../utils/url.js";
import { listNews } from "../utils/autoContent.js";

const newsDir = path.join(process.cwd(), "src", "content", "news");
const latestNews = listNews(newsDir).slice(0, 3);
---

<MainLayout
    title="Главная"
    description="Официальный сайт СНТ «Воздвиженское» НПО «Энергия». Новости, документы, реквизиты для оплаты, контакты и информация для садоводов.">

<Header />

<main>

    <!-- ===================================================== -->
    <!-- HERO -->
    <!-- ===================================================== -->

    <section class="hero">

        <h1>{organization.shortName}</h1>

        <h2>Официальный сайт товарищества</h2>

        <p class="hero-subtitle">

            Новости, решения общего собрания, документы, реквизиты для оплаты
            членских взносов, объявления правления и полезная информация для
            собственников участков.

        </p>

        <div class="hero-buttons">

            <a class="hero-button" href={withBase("/payments")}>
                💳 Оплатить взносы
            </a>

            <a class="hero-button" href={withBase("/documents")}>
                📄 Документы
            </a>

            <a class="hero-button" href={withBase("/news")}>
                📰 Новости
            </a>

            <a class="hero-button" href={withBase("/contacts")}>
                ☎ Контакты
            </a>

        </div>

    </section>

    <!-- ===================================================== -->
    <!-- IMPORTANT -->
    <!-- ===================================================== -->

    {
        announcement.enabled && (
            <section class="important-banner">

                <strong>⚠ Важная информация</strong>

                <p>
                    {announcement.text}
                </p>

                <a class="button" href={withBase(announcement.linkHref)}>
                    {announcement.linkLabel}
                </a>

            </section>
        )
    }

    <!-- ===================================================== -->
    <!-- NEWS -->
    <!-- ===================================================== -->

    <section class="section">

        <h2>Последние новости</h2>

        {
            latestNews.length === 0 ? (
                <div class="card">
                    <p>Пока нет опубликованных новостей.</p>
                </div>
            ) : (
                latestNews.map(item => (
                    <div class="card">

                        <h3>{item.title}</h3>

                        <p class="news-date">
                            {item.date.toLocaleDateString("ru-RU")}
                        </p>

                        <p>
                            {item.description}
                        </p>

                        <a class="button" href={withBase(`/news/${item.slug}`)}>
                            Подробнее →
                        </a>

                    </div>
                ))
            )
        }

        <a class="button" href={withBase("/news")}>
            Все новости →
        </a>

    </section>

    <!-- ===================================================== -->
    <!-- QUICK LINKS -->
    <!-- ===================================================== -->

    <section class="section">

        <h2>Основные разделы</h2>

        <div class="cards-grid">

            <a class="card quick-card" href={withBase("/documents")}>
                <h3>📄 Документы</h3>
                <p>Устав, протоколы, сметы, отчёты.</p>
            </a>

            <a class="card quick-card" href={withBase("/payments")}>
                <h3>💳 Взносы</h3>
                <p>Реквизиты и квитанции.</p>
            </a>

            <a class="card quick-card" href={withBase("/gallery")}>
                <h3>📷 Галерея</h3>
                <p>Фотографии товарищества.</p>
            </a>

            <a class="card quick-card" href={withBase("/calendar")}>
                <h3>📅 Календарь</h3>
                <p>Работы и мероприятия.</p>
            </a>

            <a class="card quick-card" href={withBase("/contacts")}>
                <h3>☎ Контакты</h3>
                <p>Председатель и правление.</p>
            </a>

            <a class="card quick-card" href={withBase("/about")}>
                <h3>🏡 О товариществе</h3>
                <p>История и сведения о СНТ.</p>
            </a>

        </div>

    </section>

    <!-- ===================================================== -->
    <!-- CONTACTS -->
    <!-- ===================================================== -->

    <section class="section">

        <h2>Контактная информация</h2>

        <div class="card">

            <p>

                <strong>Председатель</strong><br>

                {organization.chairman.name}

            </p>

            <p>

                <strong>Телефон</strong><br>

                <a href={`tel:${organization.chairman.phone.replace(/[^\d+]/g, "")}`}>

                    {organization.chairman.phone}

                </a>

            </p>

            <p>

                <strong>E-mail</strong><br>

                <a href={`mailto:${organization.chairman.email}`}>

                    {organization.chairman.email}

                </a>

            </p>

        </div>

    </section>

</main>

<Footer />

</MainLayout>