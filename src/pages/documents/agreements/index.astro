---
import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DocumentCard from '../../../components/DocumentCard.astro';

import path from 'node:path';
import { listDocuments } from '../../../utils/autoContent.js';
import { withBase } from '../../../utils/url.js';

const publicDocsRoot = path.join(process.cwd(), 'public', 'docs');
const agreements = listDocuments(publicDocsRoot, 'agreements');
---

<MainLayout
    title="Договора"
    description="Договора СНТ «Воздвиженское» НПО «Энергия» с подрядчиками и организациями.">

    <Header />

    <main>
        <section class="section">
            <h1>Договора</h1>

            {
                agreements.length === 0 ? (
                    <div class="card">
                        <p>Договора пока не опубликованы.</p>
                    </div>
                ) : (
                    agreements.map(item => (
                        <DocumentCard
                            title={item.title}
                            category="Договор"
                            date={item.date ? item.date.toLocaleDateString('ru-RU') : undefined}
                            file={withBase(item.file)}
                        />
                    ))
                )
            }
        </section>
    </main>

    <Footer />

</MainLayout>
