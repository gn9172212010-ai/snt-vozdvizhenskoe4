---
import MainLayout from '../../layouts/MainLayout.astro';

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import SearchBar from '../../components/SearchBar.astro';
import DocumentSection from '../../components/DocumentSection.astro';
import { withBase } from '../../utils/url.js';
---

<MainLayout
    title="Документы"
    description="Документы СНТ «Воздвиженское» НПО «Энергия»: устав, договора, протоколы собраний собственников, сметы, отчёты ревизионной комиссии, правила и регламенты, схемы СНТ, шаблоны заявлений.">

    <Header />

    <main>
        <section class="page-hero page-hero-documents">
            <h1>Документы СНТ</h1>
        </section>

        <SearchBar />

        <section class="section">
            <DocumentSection
                icon="📘"
                title="Устав"
                href={withBase("/documents/charter")}
            />

            <DocumentSection
                icon="🤝"
                title="Договора"
                href={withBase("/documents/agreements")}
            />

            <DocumentSection
                icon="📋"
                title="Протоколы собраний собственников"
                href={withBase("/documents/protocols")}
            />

            <DocumentSection
                icon="💰"
                title="Сметы"
                href={withBase("/documents/estimates")}
            />

            <DocumentSection
                icon="📊"
                title="Отчёты ревизионной комиссии"
                href={withBase("/documents/reports")}
            />

            <DocumentSection
                icon="📜"
                title="Правила и регламенты СНТ"
                href={withBase("/documents/regulations")}
            />

            <DocumentSection
                icon="🗺️"
                title="Схемы СНТ"
                href={withBase("/documents/scheme")}
            />

            <DocumentSection
                icon="📝"
                title="Шаблоны заявлений"
                href={withBase("/documents/templates")}
            />
        </section>
    </main>

    <Footer />

</MainLayout>