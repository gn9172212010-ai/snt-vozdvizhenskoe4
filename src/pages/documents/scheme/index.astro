---
import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DocumentCard from '../../../components/DocumentCard.astro';

import path from 'node:path';
import { listDocuments } from '../../../utils/autoContent.js';
import { withBase } from '../../../utils/url.js';

const publicDocsRoot = path.join(process.cwd(), 'public', 'docs');
const schemes = listDocuments(publicDocsRoot, 'scheme');
---

<MainLayout
    title="Схемы СНТ"
    description="Схемы СНТ «Воздвиженское» НПО «Энергия»: генплан, инженерные сети.">

    <Header />

    <main>
        <section class="section">
            <h1>Схемы СНТ</h1>

            {
                schemes.length === 0 ? (
                    <div class="card">
                        <p>Схемы пока не опубликованы.</p>
                    </div>
                ) : (
                    schemes.map(item => (
                        <DocumentCard
                            title={item.title}
                            category="Схема"
                            date={item.date ? item.date.toLocaleDateString('ru-RU') : undefined}
                            file={withBase(item.file)}
                        />
                    ))
                )
            }
        </section>
    </main>

    <Footer />

</MainLayout>
