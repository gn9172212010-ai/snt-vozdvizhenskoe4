---
import organization from "../data/organization.json";
import contacts from "../data/contacts.json";
import { withBase } from "../utils/url.js";

const currentYear = new Date().getFullYear();

const copyright =
    currentYear === 2026
        ? "© 2026"
        : `© 2026–${currentYear}`;
---

<footer>

    <div class="footer-content">

        <div class="footer-block">

            <h3>
                {organization.shortName}
            </h3>

            <p>
                Официальный сайт садоводческого некоммерческого товарищества.
            </p>

            <p>
                {organization.address.legal}
            </p>

        </div>


        <div class="footer-block">

            <h3>
                Контакты
            </h3>


            <p>

                <strong>
                    Председатель
                </strong>
                <br />

                {contacts.chairman.name}

            </p>


            <p>

                <a href={contacts.phone.href}>
                    {contacts.phone.display}
                </a>

            </p>


            <p>

                <a href={contacts.email.href}>
                    {contacts.email.address}
                </a>

            </p>


        </div>


        <div class="footer-block">

            <h3>
                Разделы сайта
            </h3>

            <p>
                <a href={withBase("/")}>
                    Главная
                </a>
            </p>

            <p>
                <a href={withBase("/documents")}>
                    Документы
                </a>
            </p>

            <p>
                <a href={withBase("/payments")}>
                    Взносы и оплата
                </a>
            </p>

            <p>
                <a href={withBase("/contacts")}>
                    Контакты
                </a>
            </p>

        </div>

    </div>


    <div class="footer-bottom">

        {copyright} {organization.shortName}

    </div>

</footer>