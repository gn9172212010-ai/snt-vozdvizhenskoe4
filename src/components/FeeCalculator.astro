<div class="fee-calculator">

    <h2>Калькулятор членских взносов</h2>

    <p>

        Введите номер участка:

    </p>

    <input
        id="plot-number"
        type="number"
        min="1"
        max="70"
        placeholder="Например: 27"
    >

    <div id="fee-result">

        Введите номер участка.

    </div>

</div>

<script>

const input =
    document.getElementById("plot-number");

const result =
    document.getElementById("fee-result");


const defaultFee = {

    category: "До 6 соток",

    annual: 6500,

    quarter: 1625

};


const plots = {

    11:{category:"Более 6 соток",annual:7930,quarter:1982.50},

    13:{category:"Более 6 соток",annual:9945,quarter:2486.25},

    14:{category:"Более 6 соток",annual:8710,quarter:2177.50},

    27:{category:"Более 6 соток",annual:12285,quarter:3071.25},

    28:{category:"Более 6 соток",annual:13000,quarter:3250},

    38:{category:"Более 6 соток",annual:8710,quarter:2177.50},

    39:{category:"Более 6 соток",annual:8710,quarter:2177.50},

    46:{category:"Более 6 соток",annual:9100,quarter:2275},

    48:{category:"Более 6 соток",annual:7995,quarter:1998.75},

    56:{category:"Более 6 соток",annual:8710,quarter:2177.50},

    57:{category:"Более 6 соток",annual:8710,quarter:2177.50},

    66:{category:"Более 6 соток",annual:13000,quarter:3250},

    67:{category:"Более 6 соток",annual:10920,quarter:2730},

    68:{category:"Более 6 соток",annual:13975,quarter:3493.75},

    69:{category:"Более 6 соток",annual:9880,quarter:2470},

    70:{category:"Более 6 соток",annual:14495,quarter:3623.75}

};


function money(value){

    return value.toLocaleString(

        "ru-RU",

        {

            minimumFractionDigits:
                value % 1 ? 2 : 0,

            maximumFractionDigits:2

        }

    );

}


input?.addEventListener("input",()=>{

    const number =
        Number(input.value);

    if(!number){

        result.innerHTML =
            "Введите номер участка.";

        return;

    }

    if(number < 1 || number > 70){

        result.innerHTML =
            "Участок с таким номером отсутствует.";

        return;

    }

    const fee =
        plots[number] ?? defaultFee;

    result.innerHTML = `

        <h3>Участок №${number}</h3>

        <p>

            <strong>Категория:</strong>
            ${fee.category}

        </p>

        <p>

            <strong>Годовой взнос:</strong>
            ${money(fee.annual)} ₽

        </p>

        <p>

            <strong>Поквартальный платеж:</strong>
            ${money(fee.quarter)} ₽

        </p>

        <hr>

        <p>

            Взносы уплачиваются
            <strong>ежеквартально</strong>.

        </p>

        <p>

            Срок оплаты —
            <strong>до 15 числа месяца,
            следующего за отчетным кварталом.</strong>

        </p>

        <p>

            На 2026 год
            <strong>пени не начисляются</strong>
            (решение Общего собрания от 13.06.2026).

        </p>

    `;

});

</script>