---
import organization from "../data/organization.json";
import contacts from "../data/contacts.json";
import { withBase } from "../utils/url.js";

const current = Astro.url.pathname;

const menu = [
    { href: withBase("/"), label: "Главная" },
    { href: withBase("/news"), label: "Новости" },
    { href: withBase("/documents"), label: "Документы" },
    { href: withBase("/payments"), label: "Взносы" },
    { href: withBase("/gallery"), label: "Галерея" },
    { href: withBase("/calendar"), label: "Календарь" },
    { href: withBase("/contacts"), label: "Контакты" }
];
---

<header class="site-header">

    <div class="header-top">

        <a
            class="header-logo"
            href={withBase("/")}
            aria-label="Перейти на главную страницу">

            <img
    src={withBase("/images/logo.png")}
    alt="Логотип СНТ"
    width="90"
    height="90"
    loading="eager"
    decoding="async">

            <div class="header-title">

                <div class="site-title">
                    {organization.shortName}
                </div>

                <p>
                    Официальный сайт
                </p>

                <span>
                    Сергиево-Посадский городской округ
                </span>

            </div>

        </a>


        <div class="header-contacts">

            <a
                href={contacts.phone.href}
                title="Позвонить председателю">

                📞 {contacts.phone.display}

            </a>


            <a
                href={contacts.email.href}
                title="Написать председателю">

                ✉ {contacts.email.address}

            </a>

        </div>

    </div>

</header>


<nav
    class="main-nav"
    aria-label="Главное меню">

    {
        menu.map(item => (
            <a
                href={item.href}
                class={current === item.href ? "active" : undefined}
                aria-current={current === item.href ? "page" : undefined}
            >
                {item.label}
            </a>
        ))
    }

</nav>

<div class="back-button-wrap">

    <button
        type="button"
        class="back-button"
        onclick="history.back()"
        aria-label="Вернуться на предыдущую страницу">

        ← Назад

    </button>

</div>