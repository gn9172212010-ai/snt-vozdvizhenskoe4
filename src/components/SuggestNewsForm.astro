---
// Форма отправляет данные на Formspree (formspree.io) — сторонний бесплатный
// сервис приёма форм для статических сайтов. Без него GitHub Pages не может
// принять и обработать отправленные данные.
//
// НАСТРОЙКА (один раз):
// 1. Зарегистрироваться на https://formspree.io (бесплатно)
// 2. Создать новую форму (New Form), привязать к ней почту, куда должны приходить предложения
// 3. Formspree выдаст endpoint вида https://formspree.io/f/xxxxxxxx
// 4. Вставить этот адрес вместо FORMSPREE_ENDPOINT ниже

const FORMSPREE_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID";
---

<div class="suggest-news-form card" id="suggest-news-form">

    <h2>Предложить новость</h2>

    <p>Заметили что-то важное для соседей? Расскажите — мы опубликуем.</p>

    <form
        id="suggest-form"
        data-endpoint={FORMSPREE_ENDPOINT}>

        <div class="form-group">
            <label for="suggest-name">Ваше имя (необязательно)</label>
            <input
                type="text"
                id="suggest-name"
                name="name"
                placeholder="Например, Иван, участок 42">
        </div>

        <div class="form-group">
            <label for="suggest-contact">Телефон или email для связи (необязательно)</label>
            <input
                type="text"
                id="suggest-contact"
                name="contact"
                placeholder="Если хотите получить ответ">
        </div>

        <div class="form-group">
            <label for="suggest-message">Текст новости *</label>
            <textarea
                id="suggest-message"
                name="message"
                rows="5"
                required
                placeholder="О чём рассказать соседям?"></textarea>
        </div>

        <!-- honeypot-поле против спам-ботов: людям не видно, боты его заполняют -->
        <input
            type="text"
            name="_gotcha"
            style="display:none"
            tabindex="-1"
            autocomplete="off">

        <button type="submit" class="button" id="suggest-submit">
            Отправить
        </button>

        <p class="form-status" id="suggest-status" role="status"></p>

    </form>

</div>

<script>
    const form = document.getElementById("suggest-form") as HTMLFormElement | null;
    const status = document.getElementById("suggest-status");
    const submitButton = document.getElementById("suggest-submit") as HTMLButtonElement | null;

    if (form && status && submitButton) {
        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const endpoint = form.dataset.endpoint;
            if (!endpoint || endpoint.includes("YOUR_FORM_ID")) {
                status.textContent =
                    "Форма ещё не настроена: нужно вставить свой Formspree-адрес.";
                status.className = "form-status form-status-error";
                return;
            }

            submitButton.disabled = true;
            status.textContent = "Отправляем…";
            status.className = "form-status";

            try {
                const response = await fetch(endpoint, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { Accept: "application/json" }
                });

                if (response.ok) {
                    status.textContent = "Спасибо! Мы получили вашу новость.";
                    status.className = "form-status form-status-success";
                    form.reset();
                } else {
                    status.textContent =
                        "Не получилось отправить. Попробуйте ещё раз чуть позже.";
                    status.className = "form-status form-status-error";
                }
            } catch {
                status.textContent =
                    "Не получилось отправить — проверьте соединение с интернетом.";
                status.className = "form-status form-status-error";
            } finally {
                submitButton.disabled = false;
            }
        });
    }
</script>
