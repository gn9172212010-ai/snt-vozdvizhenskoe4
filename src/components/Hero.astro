---
import { withBase } from "../utils/url.js";
---

<section class="hero">

    <div class="hero-content">

        <div class="hero-logo">

            <img

                src={withBase("/images/logo.svg")}

                alt="Логотип СНТ «Воздвиженское»"

            >

        </div>

        <h1>

            СНТ «Воздвиженское»

        </h1>

        <h2>

            Официальный сайт

        </h2>

        <p class="hero-subtitle">

            НПО «Энергия»

            <br>

            Сергиево-Посадский район Московской области

        </p>

        <div class="hero-buttons">

            <a

                class="hero-button"

                href={withBase("/news")}

            >

                📢 Новости

            </a>

            <a

                class="hero-button"

                href={withBase("/documents")}

            >

                📄 Документы

            </a>

            <a

                class="hero-button"

                href={withBase("/calendar")}

            >

                📅 Мероприятия

            </a>

            <a

                class="hero-button"

                href={withBase("/contacts")}

            >

                ☎ Контакты

            </a>

        </div>

    </div>

</section>